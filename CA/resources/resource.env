# resources.env
#
# ===================================================================

export WORKCA=/opt/ca
export WORKNGINX=/etc/nginx
export URL_APP=http://localhost:8080
export DIR_CA_ATIVA=$WORKCA/ca-ativa
export DIR_SOLICITACOES=$WORKCA/solicitacoes
export DIR_AUTORIDADES=$WORKCA/autoridades
export DIR_USUARIOS=$WORKCA/usuarios
export DIR_TEMPLATES=$WORKCA/templates
export DIR_TEMPLATES_CSR=$WORKCA/templates_csr
export DIR_RESOURCES=$WORKCA/resources
export DIR_BUNDLE=$WORKCA/bundle
export DIR_LOG=$WORKCA/logs
export DIR_PROCESSADAS=$WORKCA/processadas
export DIR_EMITIDOS=$WORKCA/emitidos
export ARQ_NGINX_CONF=$WORKNGINX/sites-available/default
export ARQ_NGINX_UPLOAD=/var/www/html/upload.php
export URL_CERTIFICADO=http://localhost:8080/certificados

# Parametros para a construção do arquivo de requisição de assinatura
# ===================================================================
export resourceDIR="$DIR_RESOURCES"
export CAdir="$DIR_AUTORIDADES"
export usuarioDir="$DIR_USUARIOS"
export bundleDir="$DIR_BUNDLE"
export dirSolicitacoes="$DIR_SOLICITACOES"
export dirCertEmitidos="$DIR_EMITIDOS"
export arquivoLog="$DIR_LOG"/ca-manager.log
export dirTemplates="$DIR_TEMPLATES_CSR"
export url_clr=http://icp-brasil.certisign.com.br/repositorio/lcr/ACCACBRFBG2/LatestCRL.crl

export template_ecpf_sefaz="$dirTemplates"/"e-cpf-sefaz.conf"
export template_ecpf_padrao="$dirTemplates"/"e-cpf.conf"
export template_ecnpj_sefaz="$dirTemplates"/"e-cnpj-sefaz.conf"
export template_ecnpj_padrao="$dirTemplates"/"e-cnpj.conf"
export template_web_server="$dirTemplates"/"web-server.conf"
export template_ca="$dirTemplates"/"ca.conf"

# Parametros de configuração do certificado
# ===========================================
#export senha_p12=123456  
export cripto_key=aes256 
export algoritmo_ass=sha256
export tamanho_key=2048
export ca_certificado="$DIR_CA_ATIVA"/sefazrj-ca.crt
export ca_key="$DIR_CA_ATIVA"/sefazrj-ca.key
export qtde_dias_ecpf=365
export qtde_dias_ecnpj=365
export qtde_dias_server=3650
export qtde_dias_ca=3650

