# Tipo do certificado solicitado.
TIPO=ECNPJ

# Campo Opcional
#Substituir pelo nome do município da pessoa jurídica
MUNICIPIO=

# Campo Opcional
# Subistituir pela razão social da pessoa jurídica
RAZAO_SOCIAL=

# Campo Opcional
# Subistituir pela uniadade da origanização que fez o pedido do certificado
DEPARTAMENTO=

# Campo Obrigatório
# Para certificados utilizados no SSA o  CNPJ precisa de 14 digitos sem mascara.
# Subistituir pelo CNPJ da pessoal juridica
CNPJ=

# Campo opcional
#Substituir pelo Email de contato da pessoal juridica
EMAIL=

# Campo opcional
# Para certificados utilizados no SSA o  INSS da PJ precisa de 12 digitos sem mascara.
# Substituir pelo INSS da pessoal juridica
INSS=

# Campo Obrigatório
# Para certificados utilizados no SSA  CPF do Responsável precisa de 11 digitos sem mascara.
# Substituir pelo CPF do responsável pelo certificado da pessoal juridica
CPF_RESP=

# Campo opcional
# Para certificados utilizados no SSA  a data de nascimento do Responsável precisa de 8 digitos (ddmmyyyy) sem mascara.
# Substituir pela data de nascimento do responsável pelo certificado da pessoal juridica se não existir preencher com oito zeros.
DT_NASCIMENTO_RESP=

# Campo opcional
# Para certificados utilizados no SSA o  RG do Responsável precisa de 15 digitos sem mascara.
# Substituir pelo RG do responsável pelo certificado da pessoal juridica
RG_RESP=

# Campo opcional
# Substituir pela SIGLA do órgão emissor do RG do responsável
ORGAO_RG_RESP=

# Campo opcional
#Substituir pela UF do órgão emissor do RG do responsável
UF_RG_RESP=

# Campo opcional
# Para certificados utilizados no SSA o  NIS do Responsável precisa de 11 digitos sem mascara.
# Substituir pelo NIS (PIS/PASEP) do responsável
NIS_RESP=

