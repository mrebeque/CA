# Tipo do certificado solicitado.

{{DT_NASCIMENTO}}{{CPF}}{{NIS}}{{RG}}{{UF_RG}}

TIPO=ECPF

# Campo opcional
# Substituir pelo nome do município da pessoa fisica
MUNICIPIO=

# Campo obrigatório
# Subistituir pela razão social da pessoa fisica
NOME=

# Campo obrigatório
# Para certificados utilizados no SSA o CPF  precisa de 11 digitos sem mascara
# Substituir pelo CPF do responsável pelo certificado da pessoal fisica
CPF=

# Campo opcional
# Substituir pelo Email de contato da pessoal fisica
EMAIL=

# Campo opcional
# Subistituir pela data de nascimento da pessoal física no formato yyyymmdd sem mascara.
DT_NASCIMENTO=

# Campo opcional
# Para certificados utilizados no SSA o RG  precisa de 15 digitos sem mascara.
# Substituir pelo RG da pessoal fisica
RG=

# Campo opcional
# Substituir pela SIGLA do órgão emissor do RG da pessoal fisica
ORGAO_RG=

# Campo opcional
# Substituir pela UF do órgão emissor do RG da pessoal fisica
UF_RG=

# Campo opcional
# NUMERO DO SEGURO SOCIAL (PIS / PASEP) da pessoal fisica precisa de 11 digitos sem mascara.
# Substituir pelo NIS (PIS/PASEP) da pessoal fisica
NIS=

# Campo opcional
# NUMERO DO BENEFICIO (INSS) da pessoal fisica precisa de 12 digitos sem mascara.
# Substituir pelo INSS da pessoal fisica
INSS=

